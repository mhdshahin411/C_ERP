@page "/Account/Login"
@layout AccountLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Nav
@inject ILogger<Login> Logger

<PageTitle>Sign in · NexusERP</PageTitle>

<div class="nx-card">
    <h1>Welcome back</h1>
    <p class="lead">Sign in to your NexusERP workspace.</p>

    @if (_error is not null)
    {
        <div class="nx-error">@_error</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="LoginUserAsync" FormName="login">
        <DataAnnotationsValidator />
        <div class="nx-field">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Input.Email" autocomplete="username" placeholder="you@company.com" />
            <ValidationMessage For="() => Input.Email" class="nx-vmsg" />
        </div>
        <div class="nx-field">
            <label for="password">Password</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" placeholder="••••••••" />
            <ValidationMessage For="() => Input.Password" class="nx-vmsg" />
        </div>
        <label class="nx-check">
            <InputCheckbox @bind-Value="Input.RememberMe" /> Keep me signed in
        </label>
        <button type="submit" class="nx-btn">Sign in</button>
    </EditForm>

    <div class="nx-demo">
        <div class="ttl">Demo accounts · click to fill</div>
        <div class="nx-demo-row">
            <button type="button" class="nx-demo-btn"
                    onclick="document.getElementById('email').value='admin@nexuserp.com';document.getElementById('password').value='Admin@123!';">
                <b>Admin</b><small>Full access</small>
            </button>
            <button type="button" class="nx-demo-btn"
                    onclick="document.getElementById('email').value='finance@nexuserp.com';document.getElementById('password').value='Finance@123!';">
                <b>Accountant</b><small>Post &amp; report</small>
            </button>
            <button type="button" class="nx-demo-btn"
                    onclick="document.getElementById('email').value='viewer@nexuserp.com';document.getElementById('password').value='Viewer@123!';">
                <b>Viewer</b><small>Read-only</small>
            </button>
        </div>
    </div>
</div>

@code {
    private string? _error;

    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    public async Task LoginUserAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {Email} signed in", Input.Email);
            Nav.NavigateTo(SafeReturnUrl()); // static SSR: framework converts this to a redirect
        }
        else
        {
            _error = "Invalid email or password.";
        }
    }

    // Only allow local return URLs to prevent open redirects.
    private string SafeReturnUrl() =>
        !string.IsNullOrEmpty(ReturnUrl) && !ReturnUrl.Contains("://") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "/";

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
