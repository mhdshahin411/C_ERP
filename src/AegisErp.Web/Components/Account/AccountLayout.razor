@inherits LayoutComponentBase

@* Static layout for sign-in pages: no interactivity, no MudBlazor providers needed.
   Styles are inline because these pages render outside the MudBlazor theme. *@
<style>
    .nx-auth { min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr; background: #f5f7fb; color: #0f172a;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased; }

    /* Left: brand panel */
    .nx-auth__side { position: relative; overflow: hidden; padding: 56px; color: #fff; display: flex; flex-direction: column; justify-content: space-between;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #9333ea 100%); }
    .nx-auth__side::before, .nx-auth__side::after { content: ""; position: absolute; border-radius: 999px; filter: blur(2px); pointer-events: none; }
    .nx-auth__side::before { width: 420px; height: 420px; right: -140px; top: -120px; background: rgba(255,255,255,.10); }
    .nx-auth__side::after  { width: 320px; height: 320px; left: -120px; bottom: -140px; background: rgba(255,255,255,.08); }
    .nx-auth__side > * { position: relative; z-index: 1; }
    .nx-auth__brand { display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: 600; letter-spacing: -.02em; }
    .nx-auth__brand b { font-weight: 800; }
    .nx-auth__mark { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
        background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.28); backdrop-filter: blur(6px); }
    .nx-auth__mark svg { width: 26px; height: 26px; display: block; }
    .nx-auth__hero h2 { font-size: 34px; line-height: 1.15; font-weight: 700; letter-spacing: -.03em; margin: 0 0 14px; max-width: 460px; }
    .nx-auth__hero p { font-size: 15px; opacity: .88; max-width: 420px; line-height: 1.6; margin: 0 0 28px; }
    .nx-auth__feat { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
    .nx-auth__feat li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; }
    .nx-auth__feat li span { width: 22px; height: 22px; border-radius: 999px; background: rgba(255,255,255,.22); display: grid; place-items: center; font-size: 12px; flex: 0 0 auto; }
    .nx-auth__foot { font-size: 12px; opacity: .72; }

    /* Right: form */
    .nx-auth__main { display: flex; align-items: center; justify-content: center; padding: 40px 24px; }
    .nx-auth__box { width: 100%; max-width: 440px; }
    .nx-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 32px; box-shadow: 0 10px 30px rgba(15,23,42,.06); }
    .nx-card h1 { font-size: 22px; font-weight: 700; letter-spacing: -.02em; margin: 0 0 4px; }
    .nx-card .lead { font-size: 13.5px; color: #64748b; margin: 0 0 22px; line-height: 1.5; }
    .nx-field { margin-bottom: 14px; }
    .nx-field label { display: block; font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 6px; }
    .nx-field input[type=text], .nx-field input[type=email], .nx-field input[type=password] {
        width: 100%; box-sizing: border-box; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 10px;
        font: inherit; font-size: 14px; color: #0f172a; background: #fff; transition: border-color .12s, box-shadow .12s; }
    .nx-field input:focus { outline: none; border-color: #4f46e5; box-shadow: 0 0 0 4px rgba(79,70,229,.15); }
    .nx-check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #334155; margin: 4px 0 20px; cursor: pointer; }
    .nx-check input { width: 16px; height: 16px; accent-color: #4f46e5; margin: 0; }
    .nx-btn { width: 100%; padding: 12px; background: #4f46e5; color: #fff; border: 0; border-radius: 10px; font: inherit; font-size: 14.5px;
        font-weight: 600; cursor: pointer; transition: background .12s, transform .06s; }
    .nx-btn:hover { background: #4338ca; }
    .nx-btn:active { transform: translateY(1px); }
    .nx-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 12px; font-size: 13px; margin-bottom: 16px; }
    .nx-vmsg { color: #b91c1c; font-size: 12px; margin-top: 4px; display: block; }
    .nx-demo { margin-top: 22px; padding-top: 18px; border-top: 1px solid #eef2f7; }
    .nx-demo .ttl { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #64748b; margin-bottom: 10px; }
    .nx-demo-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .nx-demo-btn { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0;
        border-radius: 10px; cursor: pointer; font: inherit; text-align: left; transition: border-color .12s, background .12s; }
    .nx-demo-btn:hover { border-color: #4f46e5; background: #eef2ff; }
    .nx-demo-btn b { font-size: 12.5px; color: #0f172a; }
    .nx-demo-btn small { font-size: 11px; color: #64748b; }
    .nx-link { color: #4f46e5; font-weight: 600; text-decoration: none; font-size: 13.5px; }
    .nx-link:hover { text-decoration: underline; }
    .nx-mobile-brand { display: none; }

    @@media (max-width: 900px) {
        .nx-auth { grid-template-columns: 1fr; }
        .nx-auth__side { display: none; }
        .nx-mobile-brand { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 22px;
            font-size: 20px; font-weight: 600; letter-spacing: -.02em; color: #0f172a; }
        .nx-mobile-brand b { font-weight: 800; color: #4f46e5; }
        .nx-mobile-brand .nx-auth__mark { width: 36px; height: 36px; border-radius: 10px; border: 0; background: linear-gradient(135deg, #6366f1, #8b5cf6); }
        .nx-mobile-brand .nx-auth__mark svg { width: 22px; height: 22px; }
        .nx-demo-row { grid-template-columns: 1fr; }
    }
</style>

<div class="nx-auth">
    <aside class="nx-auth__side">
        <div class="nx-auth__brand">
            <span class="nx-auth__mark">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M20 46V18h6l12 18V18h6v28h-6L26 28v18z" fill="#fff" />
                </svg>
            </span>
            <span>Nexus<b>ERP</b></span>
        </div>

        <div class="nx-auth__hero">
            <h2>Finance &amp; operations, beautifully connected.</h2>
            <p>One system for your ledger, receivables, VAT and reports — always balanced, always current.</p>
            <ul class="nx-auth__feat">
                <li><span>✓</span> Double-entry ledger with live reports</li>
                <li><span>✓</span> Sales invoices, receipts &amp; AR aging</li>
                <li><span>✓</span> UAE VAT (5%) &amp; corporate-tax ready</li>
                <li><span>✓</span> Role-based access for your team</li>
            </ul>
        </div>

        <div class="nx-auth__foot">© @DateTime.Now.Year NexusERP · Secure sign-in</div>
    </aside>

    <main class="nx-auth__main">
        <div class="nx-auth__box">
            <div class="nx-mobile-brand">
                <span class="nx-auth__mark">
                    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M20 46V18h6l12 18V18h6v28h-6L26 28v18z" fill="#fff" />
                    </svg>
                </span>
                <span>Nexus<b>ERP</b></span>
            </div>
            @Body
        </div>
    </main>
</div>
