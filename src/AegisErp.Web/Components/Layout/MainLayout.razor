@inherits LayoutComponentBase
@inject LedgerService Ledger
@inject CompanyService Company

@* One-way IsDarkMode: the app controls the theme (default light) so the OS preference can't flip it unexpectedly. The toolbar button toggles _isDark. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />

        <a href="/" class="nx-brand" aria-label="NexusERP home">
            <span class="nx-brand__mark">
                <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M20 46V18h6l12 18V18h6v28h-6L26 28v18z" fill="#fff" />
                </svg>
            </span>
            <span class="nx-brand__name">Nexus<b>ERP</b></span>
        </a>

        <MudSpacer />

        <div class="d-none d-md-flex align-center gap-2 mr-2">
            <span class="nx-pill"><MudIcon Icon="@Icons.Material.Filled.Business" /> @_companyLabel</span>
            <span class="nx-pill"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" /> @_periodLabel</span>
        </div>

        <MudTooltip Text="@(_isDark ? "Switch to light theme" : "Switch to dark theme")">
            <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="@(() => _isDark = !_isDark)" />
        </MudTooltip>

        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-1">
                    <ActivatorContent>
                        <div class="nx-user">
                            <MudAvatar Size="Size.Small" Class="nx-avatar">@Initials(context.User.Identity?.Name)</MudAvatar>
                            <span class="d-none d-sm-inline">@DisplayName(context.User.Identity?.Name)</span>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-3" style="min-width:230px">
                            <MudText Typo="Typo.body2"><b>@context.User.Identity?.Name</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Roles(context.User)</MudText>
                        </div>
                        <MudDivider />
                        <form action="Account/Logout" method="post" class="px-2 py-1">
                            <AntiforgeryToken />
                            <button type="submit" class="nx-signout">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" /> Sign out
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Width="264px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="nx-page">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDark = false;
    private string _periodLabel = "…";
    private string _companyLabel = "…";

    protected override async Task OnInitializedAsync()
    {
        var p = await Ledger.GetDefaultPeriodAsync(DateOnly.FromDateTime(DateTime.Today));
        _periodLabel = p is null ? "No period" : $"Period {p.PeriodNo} · {p.Name}";

        var c = await Company.GetAsync();
        var place = string.IsNullOrWhiteSpace(c.Emirate) ? c.Country : c.Emirate;
        _companyLabel = string.IsNullOrWhiteSpace(place) ? c.LegalName : $"{c.LegalName} · {place}";
    }

    private static string LocalPart(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "User";
        var at = name.IndexOf('@');
        return at > 0 ? name[..at] : name;
    }

    private static string DisplayName(string? name)
    {
        var l = LocalPart(name);
        return char.ToUpperInvariant(l[0]) + l[1..];
    }

    private static string Initials(string? name)
    {
        var l = LocalPart(name);
        var parts = l.Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        return (l.Length >= 2 ? l[..2] : l).ToUpperInvariant();
    }

    private static string Roles(System.Security.Claims.ClaimsPrincipal user) =>
        string.Join(", ", user.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));

    // NexusERP palette — indigo accent on a cool slate neutral scale, tuned for both modes.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4f46e5",
            PrimaryContrastText = "#ffffff",
            Secondary = "#7c3aed",
            SecondaryContrastText = "#ffffff",
            Tertiary = "#0d9488",
            Info = "#0284c7",
            Success = "#16a34a",
            Warning = "#d97706",
            Error = "#dc2626",
            Dark = "#0f172a",

            Background = "#f5f7fb",
            Surface = "#ffffff",
            BackgroundGray = "#f1f4f9",

            AppbarBackground = "#ffffff",
            AppbarText = "#0f172a",
            DrawerBackground = "#ffffff",
            DrawerText = "#334155",
            DrawerIcon = "#64748b",

            TextPrimary = "#0f172a",
            TextSecondary = "#64748b",
            TextDisabled = "rgba(15,23,42,0.38)",
            ActionDefault = "#64748b",
            ActionDisabled = "rgba(15,23,42,0.26)",
            ActionDisabledBackground = "rgba(15,23,42,0.08)",

            LinesDefault = "#e2e8f0",
            LinesInputs = "#cbd5e1",
            Divider = "#e8edf3",
            DividerLight = "rgba(15,23,42,0.05)",
            TableLines = "#eef2f7",
            TableStriped = "rgba(15,23,42,0.015)",
            TableHover = "rgba(79,70,229,0.05)",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818cf8",
            PrimaryContrastText = "#0b1220",
            Secondary = "#a78bfa",
            SecondaryContrastText = "#0b1220",
            Tertiary = "#2dd4bf",
            Info = "#38bdf8",
            Success = "#4ade80",
            Warning = "#fbbf24",
            Error = "#f87171",
            Dark = "#020617",

            Background = "#0b1220",     // page
            Surface = "#111a2e",        // cards / paper
            BackgroundGray = "#162036",

            AppbarBackground = "#111a2e",
            AppbarText = "#e2e8f0",
            DrawerBackground = "#0f172a",
            DrawerText = "#cbd5e1",
            DrawerIcon = "#94a3b8",

            TextPrimary = "#e2e8f0",
            TextSecondary = "#94a3b8",
            TextDisabled = "rgba(226,232,240,0.34)",
            ActionDefault = "#94a3b8",
            ActionDisabled = "rgba(226,232,240,0.26)",
            ActionDisabledBackground = "rgba(226,232,240,0.10)",

            LinesDefault = "#1e293b",
            LinesInputs = "#334155",
            Divider = "#1e293b",
            DividerLight = "rgba(255,255,255,0.06)",
            TableLines = "#1e293b",
            TableStriped = "rgba(255,255,255,0.02)",
            TableHover = "rgba(129,140,248,0.08)",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
            AppbarHeight = "60px",
            DrawerWidthLeft = "264px",
        }
    };
}
