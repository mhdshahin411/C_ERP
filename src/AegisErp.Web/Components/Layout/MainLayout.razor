@inherits LayoutComponentBase
@inject LedgerService Ledger

@* One-way IsDarkMode: the app controls the theme (default light) so the OS preference can't flip it unexpectedly. The toolbar button toggles _isDark. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-weight:700;letter-spacing:-.3px">Aegis&nbsp;ERP</MudText>
        <MudText Typo="Typo.caption" Class="ml-2 d-none d-sm-flex" Style="opacity:.7">Finance &amp; Operations</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Icon="@Icons.Material.Filled.Business" Class="d-none d-md-flex">Aegis FZE · UAE</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Icon="@Icons.Material.Filled.CalendarMonth" Class="d-none d-md-flex">@_periodLabel</MudChip>
        <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _isDark = !_isDark)" />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudChip T="string" Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Variant="Variant.Text">
                            @context.User.Identity?.Name
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.body2"><b>@context.User.Identity?.Name</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))
                            </MudText>
                        </div>
                        <MudDivider />
                        <form action="Account/Logout" method="post" class="px-4 py-2">
                            <AntiforgeryToken />
                            <button type="submit"
                                    style="background:none;border:none;cursor:pointer;color:var(--mud-palette-error);font-size:13px;font-weight:600;padding:0">
                                Sign out
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@* App-bar text/chips: MudChip's text variant dims the inherited colour to a faint grey on the
   navy bar. Force crisp white with a subtle translucent pill so they read clearly. *@
<style>
    .mud-appbar .mud-chip.mud-chip-text {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.10);
        font-weight: 500;
    }
    .mud-appbar .mud-chip .mud-chip-icon,
    .mud-appbar .mud-chip .mud-icon-root,
    .mud-appbar .mud-chip.mud-chip-text:hover {
        color: rgba(255, 255, 255, 0.9) !important;
    }
    .mud-appbar .mud-chip.mud-chip-text:hover {
        background-color: rgba(255, 255, 255, 0.18);
    }
    /* Toolbar icon buttons (menu, dark-mode) crisp white */
    .mud-appbar .mud-icon-button { color: rgba(255, 255, 255, 0.9); }
</style>

@code {
